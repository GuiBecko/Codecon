# Copie para .env (não versionado) e preencha. Sem SMTP_PASS, os e-mails só ficam na caixa de demonstração (/emails.html).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=guilherme2becker@gmail.com
# senha de app do Gmail: https://myaccount.google.com/apppasswords
SMTP_PASS=
MAIL_FROM="Conecta Vagas <guilherme2becker@gmail.com>"
# Opcional: entrega todos os e-mails neste endereço (os usuários demo têm e-mails fictícios)
MAIL_REDIRECT_TO=guilherme2becker@gmail.com
# Opcional: sobrescreve as variáveis acima, ex.: smtps://usuario:senha@smtp.exemplo.com
# SMTP_URL=
